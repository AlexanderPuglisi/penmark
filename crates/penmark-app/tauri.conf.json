{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PenMark",
  "version": "0.1.0",
  "identifier": "io.github.alexanderpuglisi.penmark",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PenMark",
        "width": 1280,
        "height": 800,
        "minWidth": 1040,
        "minHeight": 680,
        "center": true,
        "backgroundColor": "#07050f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Alexander Puglisi",
    "copyright": "Copyright 2026 Alexander Puglisi",
    "license": "Apache-2.0",
    "category": "Utility",
    "shortDescription": "Sign what you create and prove it is yours and since when.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
